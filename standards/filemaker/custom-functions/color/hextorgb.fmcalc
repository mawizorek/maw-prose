Let ( [
	_map = "0123456789ABCDEF" ;

	_in = Upper ( Substitute ( Trim ( hex ) ; [ "#" ; "" ] ; [ " " ; "" ] ) ) ;
	_len = Length ( _in ) ;
	_clean = Length ( Filter ( _in ; _map ) ) = _len and _len > 0 ;

	_h = Case (
		_len = 3 ;
		Middle ( _in ; 1 ; 1 ) & Middle ( _in ; 1 ; 1 ) &
		Middle ( _in ; 2 ; 1 ) & Middle ( _in ; 2 ; 1 ) &
		Middle ( _in ; 3 ; 1 ) & Middle ( _in ; 3 ; 1 ) ;
		_in
	) ;

	_ok = _clean and Length ( _h ) = 6 ;

	_r = ( Position ( _map ; Middle ( _h ; 1 ; 1 ) ; 1 ; 1 ) - 1 ) * 16 + ( Position ( _map ; Middle ( _h ; 2 ; 1 ) ; 1 ; 1 ) - 1 ) ;
	_g = ( Position ( _map ; Middle ( _h ; 3 ; 1 ) ; 1 ; 1 ) * 16 ) - 16 + ( Position ( _map ; Middle ( _h ; 4 ; 1 ) ; 1 ; 1 ) - 1 ) ;
	_b = ( Position ( _map ; Middle ( _h ; 5 ; 1 ) ; 1 ; 1 ) * 16 ) - 16 + ( Position ( _map ; Middle ( _h ; 6 ; 1 ) ; 1 ; 1 ) - 1 )
] ;
	Case (
		not _ok ;
		JSONSetElement ( "{}" ;
			[ "ok" ; False ; JSONBoolean ] ;
			[ "error" ; "expected 3 or 6 hex digits" ; JSONString ]
		) ;

		JSONSetElement ( "{}" ;
			[ "ok" ; True ; JSONBoolean ] ;
			[ "r" ; _r ; JSONNumber ] ;
			[ "g" ; _g ; JSONNumber ] ;
			[ "b" ; _b ; JSONNumber ]
		)
	)
)
