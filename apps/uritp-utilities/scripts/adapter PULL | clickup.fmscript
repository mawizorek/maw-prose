# adapter PULL | clickup · URITP Utilities. Organizer: session > page > tombstone (full runs only) > fields. Stops at the first module that fails and returns its error.
# Param: view (ClickUp view ID; MUST show closed tasks), cap (optional; > 0 = capped test run, no tombstoning). Result: one summary JSON.
Set Error Capture [ On ]
Allow User Abort [ Off ]
Freeze Window
Perform Script [ Specified: From list ; "adapter PULL | clickup | session" ; Parameter: Get ( ScriptParameter ) ]
Set Variable [ $s ; Value: Get ( ScriptResult ) ]
If [ not ParamGetBool ( $s ; "ok" ; 0 ) ]
	Exit Script [ Text Result: $s ]
End If
Perform Script [ Specified: From list ; "adapter PULL | clickup | page" ; Parameter: $s ]
Set Variable [ $p ; Value: Get ( ScriptResult ) ]
If [ not ParamGetBool ( $p ; "ok" ; 0 ) ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; ParamGetText ( $p ; "error" ; "" ) ) ; PText ( "session" ; ParamGetText ( $s ; "session" ; "" ) ) ) ) ]
End If
Perform Script [ Specified: From list ; "adapter PULL | clickup | tombstone" ; Parameter: $s ]
Set Variable [ $t ; Value: Get ( ScriptResult ) ]
If [ not ParamGetBool ( $t ; "ok" ; 0 ) ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; ParamGetText ( $t ; "error" ; "" ) ) ; PText ( "session" ; ParamGetText ( $s ; "session" ; "" ) ) ) ) ]
End If
Perform Script [ Specified: From list ; "adapter PULL | clickup | fields" ; Parameter: $s ]
Set Variable [ $f ; Value: Get ( ScriptResult ) ]
If [ not ParamGetBool ( $f ; "ok" ; 0 ) ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; ParamGetText ( $f ; "error" ; "" ) ) ; PText ( "session" ; ParamGetText ( $s ; "session" ; "" ) ) ) ) ]
End If
Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 1 ) ; PText ( "session" ; ParamGetText ( $s ; "session" ; "" ) ) ; PNum ( "full" ; ParamGetNumber ( $s ; "full" ; 0 ) ) ; PNum ( "seen" ; ParamGetNumber ( $p ; "seen" ; 0 ) ) ; PNum ( "created" ; ParamGetNumber ( $p ; "created" ; 0 ) ) ; PNum ( "changed" ; ParamGetNumber ( $p ; "changed" ; 0 ) ) ; PNum ( "unchanged" ; ParamGetNumber ( $p ; "unchanged" ; 0 ) ) ; PNum ( "revived" ; ParamGetNumber ( $p ; "revived" ; 0 ) ) ; PNum ( "tombstoned" ; ParamGetNumber ( $t ; "tombstoned" ; 0 ) ) ; PNum ( "fields_created" ; ParamGetNumber ( $f ; "created" ; 0 ) ) ; PNum ( "fields_updated" ; ParamGetNumber ( $f ; "updated" ; 0 ) ) ; PText ( "warnings" ; List ( ParamGetText ( $p ; "warnings" ; "" ) ; ParamGetText ( $t ; "warnings" ; "" ) ) ) ) ) ]
