# adapter PULL | clickup | page · URITP Utilities. Walks the view page by page and hands each task to upsert. Any HTTP error is logged and stops the run.
# Param: the session result (session, container, system, view, full, cap). Result: ok, seen, created, changed, unchanged, revived, warnings.
Set Error Capture [ On ]
Set Variable [ $s ; Value: Get ( ScriptParameter ) ]
Set Variable [ $cap ; Value: ParamGetNumber ( $s ; "cap" ; 0 ) ]
Set Variable [ $page ; Value: 0 ]
Set Variable [ $seen ; Value: 0 ]
Set Variable [ $created ; Value: 0 ]
Set Variable [ $changed ; Value: 0 ]
Set Variable [ $unchanged ; Value: 0 ]
Set Variable [ $revived ; Value: 0 ]
Set Variable [ $warnings ; Value: "" ]
Loop
	Perform Script [ Specified: From list ; "http | clickup" ; Parameter: JSONSetElement ( "{}" ; [ "path" ; "/view/" & JSONGetElement ( $s ; "view" ) & "/task?page=" & $page ; JSONString ] ) ]
	Set Variable [ $r ; Value: Get ( ScriptResult ) ]
	If [ JSONGetElement ( $r ; "status" ) <> 200 ]
		Perform Script [ Specified: From list ; "log | event" ; Parameter: JSONSetElement ( "{}" ; [ "session" ; JSONGetElement ( $s ; "session" ) ; JSONString ] ; [ "key" ; "" ; JSONString ] ; [ "action" ; "pull" ; JSONString ] ; [ "status" ; GetAsNumber ( JSONGetElement ( $r ; "status" ) ) ; JSONNumber ] ; [ "request" ; JSONGetElement ( $r ; "url" ) ; JSONString ] ; [ "response" ; Left ( ParamGetText ( $r ; "error" ; "" ) & JSONGetElement ( $r ; "body" ) ; 2000 ) ; JSONString ] ) ]
		Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "page " & $page & ": HTTP " & JSONGetElement ( $r ; "status" ) & " " & ParamGetText ( $r ; "error" ; "" ) & ". Run stopped; nothing tombstoned." ; JSONString ] ) ]
	End If
	Set Variable [ $body ; Value: JSONGetElement ( $r ; "body" ) ]
	Set Variable [ $tasks ; Value: JSONGetElement ( $body ; "tasks" ) ]
	If [ Left ( $tasks ; 1 ) = "?" ]
		Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "page " & $page & ": response has no tasks array" ; JSONString ] ) ]
	End If
	Set Variable [ $n ; Value: ValueCount ( JSONListKeys ( $tasks ; "" ) ) ]
	Set Variable [ $i ; Value: 0 ]
	Loop
		Exit Loop If [ $i >= $n or ( $cap > 0 and $seen >= $cap ) ]
		Set Variable [ $task ; Value: JSONGetElement ( $tasks ; "[" & $i & "]" ) ]
		Perform Script [ Specified: From list ; "adapter PULL | clickup | upsert" ; Parameter: JSONSetElement ( "{}" ; [ "session" ; JSONGetElement ( $s ; "session" ) ; JSONString ] ; [ "container" ; JSONGetElement ( $s ; "container" ) ; JSONString ] ; [ "system" ; JSONGetElement ( $s ; "system" ) ; JSONString ] ; [ "full" ; ParamGetBool ( $s ; "full" ; 0 ) ; JSONNumber ] ; [ "task" ; $task ; JSONObject ] ; [ "request" ; JSONGetElement ( $r ; "url" ) ; JSONString ] ) ]
		Set Variable [ $u ; Value: Get ( ScriptResult ) ]
		If [ not JSONGetElement ( $u ; "ok" ) ]
			Exit Script [ Text Result: $u ]
		End If
		Set Variable [ $seen ; Value: $seen + 1 ]
		Set Variable [ $created ; Value: $created + ( JSONGetElement ( $u ; "action" ) = "created" ) ]
		Set Variable [ $changed ; Value: $changed + ( JSONGetElement ( $u ; "action" ) = "changed" ) ]
		Set Variable [ $unchanged ; Value: $unchanged + ( JSONGetElement ( $u ; "action" ) = "unchanged" ) ]
		Set Variable [ $revived ; Value: $revived + GetAsNumber ( JSONGetElement ( $u ; "revived" ) ) ]
		If [ not IsEmpty ( JSONGetElement ( $u ; "warning" ) ) ]
			Set Variable [ $warnings ; Value: List ( $warnings ; JSONGetElement ( $u ; "warning" ) & " " & JSONGetElement ( $task ; "id" ) ) ]
		End If
		Set Variable [ $i ; Value: $i + 1 ]
	End Loop
	Exit Loop If [ $n = 0 or ( $cap > 0 and $seen >= $cap ) or JSONGetElement ( $body ; "last_page" ) = 1 or JSONGetElement ( $body ; "last_page" ) = "true" ]
	Set Variable [ $page ; Value: $page + 1 ]
	If [ $page > 500 ]
		Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "more than 500 pages; stopped as a runaway guard" ; JSONString ] ) ]
	End If
End Loop
Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 1 ; JSONNumber ] ; [ "seen" ; $seen ; JSONNumber ] ; [ "created" ; $created ; JSONNumber ] ; [ "changed" ; $changed ; JSONNumber ] ; [ "unchanged" ; $unchanged ; JSONNumber ] ; [ "revived" ; $revived ; JSONNumber ] ; [ "warnings" ; $warnings ; JSONString ] ) ]
