# adapter PULL | clickup | session · URITP Utilities. Resolves the source by view ID (a fact, never Name_Display), checks the system and its HTTP add-on, opens one sync_SESSION.
# Param: view, cap. Result: ok, session, source, container, system, view, full, cap.
Set Error Capture [ On ]
Set Variable [ $param ; Value: Get ( ScriptParameter ) ]
Set Variable [ $view ; Value: ParamGetText ( $param ; "view" ; "" ) ]
Set Variable [ $cap ; Value: ParamGetNumber ( $param ; "cap" ; 0 ) ]
If [ IsEmpty ( $view ) ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "no view in parameter" ) ) ) ]
End If
Set Variable [ $src ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( sync_SOURCE::PrimaryKey ) ) & ", " & sql.Field ( GetFieldName ( sync_SOURCE::fk_xtContainer ) ) & " FROM " & sql.Table ( GetFieldName ( sync_SOURCE::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( sync_SOURCE::xt_ViewPath ) ) & " = ? AND " & sql.Field ( GetFieldName ( sync_SOURCE::isActive ) ) & " = 1" ; "|" ; ¶ ; $view ) ]
If [ ValueCount ( $src ) <> 1 or Left ( $src ; 1 ) = "?" ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "need exactly one active sync_SOURCE for view " & $view ) ) ) ]
End If
Set Variable [ $source ; Value: GetValue ( Substitute ( $src ; "|" ; ¶ ) ; 1 ) ]
Set Variable [ $container ; Value: GetValue ( Substitute ( $src ; "|" ; ¶ ) ; 2 ) ]
Set Variable [ $system ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( xt_CONTAINER::fk_xtSystem ) ) & " FROM " & sql.Table ( GetFieldName ( xt_CONTAINER::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( xt_CONTAINER::PrimaryKey ) ) & " = ? AND " & sql.Field ( GetFieldName ( xt_CONTAINER::isActive ) ) & " = 1" ; "" ; "" ; $container ) ]
If [ ValueCount ( $system ) <> 1 or Left ( $system ; 1 ) = "?" ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "source container missing or inactive" ) ) ) ]
End If
Set Variable [ $system ; Value: GetValue ( $system ; 1 ) ]
Set Variable [ $code ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( xt_SYSTEM::Code ) ) & " FROM " & sql.Table ( GetFieldName ( xt_SYSTEM::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( xt_SYSTEM::PrimaryKey ) ) & " = ?" ; "" ; "" ; $system ) ]
#--- BaseURL and Token are validated not-empty on the add-on itself, so one row is enough to know they are there
Set Variable [ $http ; Value: ExecuteSQL ( "SELECT COUNT(*) FROM " & sql.Table ( GetFieldName ( xt_SYSTEM_HTTP::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( xt_SYSTEM_HTTP::fk_xtSystem ) ) & " = ?" ; "" ; "" ; $system ) ]
If [ GetValue ( $code ; 1 ) <> "clickup" or GetAsNumber ( $http ) <> 1 ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "system is not clickup, or it has no xt_SYSTEM_HTTP row (BaseURL, Token)" ) ) ) ]
End If
Go to Layout [ "sync_SESSION" ]
New Record/Request
Set Field [ sync_SESSION::fk_Source ; $source ]
Set Field [ sync_SESSION::isFullPull ; If ( $cap > 0 ; 0 ; 1 ) ]
Commit Records/Requests [ ]
If [ Get ( LastError ) <> 0 ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "commit failed (sync_SESSION): error " & Get ( LastError ) ) ) ) ]
End If
Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 1 ) ; PText ( "session" ; sync_SESSION::PrimaryKey ) ; PText ( "source" ; $source ) ; PText ( "container" ; $container ) ; PText ( "system" ; $system ) ; PText ( "view" ; $view ) ; PNum ( "full" ; If ( $cap > 0 ; 0 ; 1 ) ) ; PNum ( "cap" ; $cap ) ) ) ]
