# adapter PULL | clickup | session · URITP Utilities. Resolves the source by view ID (a fact, never Name_Display), checks the system, opens one sync_SESSION.
# Param: view, cap. Result: ok, session, source, container, system, view, full, cap.
Set Error Capture [ On ]
Set Variable [ $param ; Value: Get ( ScriptParameter ) ]
Set Variable [ $view ; Value: ParamGetText ( $param ; "view" ; "" ) ]
Set Variable [ $cap ; Value: ParamGetNumber ( $param ; "cap" ; 0 ) ]
If [ IsEmpty ( $view ) ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "no view in parameter" ; JSONString ] ) ]
End If
Set Variable [ $src ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( sync_SOURCE::PrimaryKey ) ) & ", " & sql.Field ( GetFieldName ( sync_SOURCE::fk_xtContainer ) ) & " FROM " & sql.Table ( GetFieldName ( sync_SOURCE::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( sync_SOURCE::xt_ViewPath ) ) & " = ? AND " & sql.Field ( GetFieldName ( sync_SOURCE::isActive ) ) & " = 1" ; "|" ; ¶ ; $view ) ]
If [ ValueCount ( $src ) <> 1 or Left ( $src ; 1 ) = "?" ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "need exactly one active sync_SOURCE for view " & $view ; JSONString ] ) ]
End If
Set Variable [ $source ; Value: GetValue ( Substitute ( $src ; "|" ; ¶ ) ; 1 ) ]
Set Variable [ $container ; Value: GetValue ( Substitute ( $src ; "|" ; ¶ ) ; 2 ) ]
Set Variable [ $system ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( xt_CONTAINER::fk_xtSystem ) ) & " FROM " & sql.Table ( GetFieldName ( xt_CONTAINER::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( xt_CONTAINER::PrimaryKey ) ) & " = ? AND " & sql.Field ( GetFieldName ( xt_CONTAINER::isActive ) ) & " = 1" ; "" ; "" ; $container ) ]
If [ ValueCount ( $system ) <> 1 or Left ( $system ; 1 ) = "?" ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "source container missing or inactive" ; JSONString ] ) ]
End If
Set Variable [ $system ; Value: GetValue ( $system ; 1 ) ]
Set Variable [ $code ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( xt_SYSTEM::Code ) ) & " FROM " & sql.Table ( GetFieldName ( xt_SYSTEM::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( xt_SYSTEM::PrimaryKey ) ) & " = ? AND " & sql.Field ( GetFieldName ( xt_SYSTEM::BaseURL ) ) & " IS NOT NULL AND " & sql.Field ( GetFieldName ( xt_SYSTEM::Token ) ) & " IS NOT NULL" ; "" ; "" ; $system ) ]
If [ GetValue ( $code ; 1 ) <> "clickup" ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "system is not clickup, or BaseURL / Token is empty" ; JSONString ] ) ]
End If
Go to Layout [ "sync_SESSION" ]
New Record/Request
Set Field [ sync_SESSION::fk_Source ; $source ]
Set Field [ sync_SESSION::isFullPull ; If ( $cap > 0 ; 0 ; 1 ) ]
Commit Records/Requests [ ]
If [ Get ( LastError ) <> 0 ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "commit failed (sync_SESSION): error " & Get ( LastError ) ; JSONString ] ) ]
End If
Exit Script [ Text Result: JSONSetElement ( "{}" ; [ "ok" ; 1 ; JSONNumber ] ; [ "session" ; sync_SESSION::PrimaryKey ; JSONString ] ; [ "source" ; $source ; JSONString ] ; [ "container" ; $container ; JSONString ] ; [ "system" ; $system ; JSONString ] ; [ "view" ; $view ; JSONString ] ; [ "full" ; If ( $cap > 0 ; 0 ; 1 ) ; JSONNumber ] ; [ "cap" ; $cap ; JSONNumber ] ) ]
