# log | event · URITP Utilities. The only script that writes sync_EVENT and sync_CHANGE, so every event has one shape. Codes and external keys only; never a token.
# Param: session, key, action (sync_action code), status, request, response, changes (optional array of code, label, old, new, change: one sync_CHANGE row each, written in diff order). Result: ok, action, event, moves.
Set Error Capture [ On ]
Set Variable [ $param ; Value: Get ( ScriptParameter ) ]
Set Variable [ $action ; Value: ParamGetText ( $param ; "action" ; "" ) ]
Set Variable [ $changes ; Value: ParamGetText ( $param ; "changes" ; "" ) ]
Set Variable [ $listPK ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( value_LIST::PrimaryKey ) ) & " FROM " & sql.Table ( GetFieldName ( value_LIST::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( value_LIST::Code ) ) & " = ?" ; "" ; "" ; "sync_action" ) ]
If [ ValueCount ( $listPK ) <> 1 or Left ( $listPK ; 1 ) = "?" ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "need exactly one value_LIST sync_action" ) ) ) ]
End If
Set Variable [ $label ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( VALUE::Name_Display ) ) & " FROM " & sql.Table ( GetFieldName ( VALUE::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( VALUE::fk_List ) ) & " = ? AND " & sql.Field ( GetFieldName ( VALUE::Code ) ) & " = ?" ; "" ; "" ; GetValue ( $listPK ; 1 ) ; $action ) ]
If [ ValueCount ( $label ) <> 1 or Left ( $label ; 1 ) = "?" ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "unknown sync_action code: " & $action ) ) ) ]
End If
Go to Layout [ "sync_EVENT" ]
New Record/Request
Set Field [ sync_EVENT::fk_Session ; ParamGetText ( $param ; "session" ; "" ) ]
Set Field [ sync_EVENT::xt_Key ; ParamGetText ( $param ; "key" ; "" ) ]
Set Field [ sync_EVENT::ActionCode ; $action ]
Set Field [ sync_EVENT::stored_ActionLabel ; GetValue ( $label ; 1 ) ]
Set Field [ sync_EVENT::HttpStatus ; ParamGetNumber ( $param ; "status" ; "" ) ]
Set Field [ sync_EVENT::Request ; ParamGetText ( $param ; "request" ; "" ) ]
Set Field [ sync_EVENT::Response ; ParamGetText ( $param ; "response" ; "" ) ]
Commit Records/Requests [ ]
If [ Get ( LastError ) <> 0 ]
	Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "commit failed (sync_EVENT): error " & Get ( LastError ) ) ) ) ]
End If
Set Variable [ $event ; Value: sync_EVENT::PrimaryKey ]
#--- moves: one sync_CHANGE row per changed field. Creation order is the display order.
Set Variable [ $k ; Value: If ( Left ( $changes ; 1 ) = "[" ; ValueCount ( JSONListKeys ( $changes ; "" ) ) ; 0 ) ]
Set Variable [ $j ; Value: 0 ]
If [ $k > 0 ]
	Go to Layout [ "sync_CHANGE" ]
	Loop
		Exit Loop If [ $j >= $k ]
		Set Variable [ $c ; Value: JSONGetElement ( $changes ; "[" & $j & "]" ) ]
		New Record/Request
		Set Field [ sync_CHANGE::fk_Event ; $event ]
		Set Field [ sync_CHANGE::FieldCode ; JSONGetElement ( $c ; "code" ) ]
		Set Field [ sync_CHANGE::stored_FieldLabel ; JSONGetElement ( $c ; "label" ) ]
		Set Field [ sync_CHANGE::OldValue ; JSONGetElement ( $c ; "old" ) ]
		Set Field [ sync_CHANGE::NewValue ; JSONGetElement ( $c ; "new" ) ]
		Set Field [ sync_CHANGE::Change ; JSONGetElement ( $c ; "change" ) ]
		Commit Records/Requests [ ]
		If [ Get ( LastError ) <> 0 ]
			Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 0 ) ; PText ( "error" ; "commit failed (sync_CHANGE " & JSONGetElement ( $c ; "code" ) & "): error " & Get ( LastError ) ) ; PText ( "event" ; $event ) ) ) ]
		End If
		Set Variable [ $j ; Value: $j + 1 ]
	End Loop
End If
Exit Script [ Text Result: Param ( List ( PNum ( "ok" ; 1 ) ; PText ( "action" ; $action ) ; PText ( "event" ; $event ) ; PNum ( "moves" ; $k ) ) ) ]
