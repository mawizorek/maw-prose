# sync RUN
# The button. One press syncs one source: pull, dispatch, push.
# Param (text): a sync_SOURCES Name, e.g. "PEOPLE".
# Returns (JSON): { "ok" : 1|0, "session" : "<PrimaryKey>", "pulled" : n, "dispatched" : n, "pushed" : n }
#
# --- LAYOUTS ---
Set Variable [ $table_syncSessions ; Value: "table | sync_SESSIONS" ]
#
Set Error Capture [ On ]
Allow User Abort [ Off ]
Set Variable [ $sourceName ; Value: Get ( ScriptParameter ) ]
If [ IsEmpty ( $sourceName ) ]
	Show Custom Dialog [ Get ( ScriptName ) ; "Pass a sync_SOURCES Name as the parameter, e.g. \"PEOPLE\"." ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ]
End If
#
# ---------- context read ----------
Set Variable [ $ctx ; Value: ExecuteSQL ( "SELECT src." & sql.Field ( GetFieldName ( sync_SOURCES::PrimaryKey ) ) & ", src." & sql.Field ( GetFieldName ( sync_SOURCES::fk_xtContainer ) ) & ", src." & sql.Field ( GetFieldName ( sync_SOURCES::xt_ViewPath ) ) & ", c." & sql.Field ( GetFieldName ( xt_CONTAINERS::xt_ID ) ) & ", c." & sql.Field ( GetFieldName ( xt_CONTAINERS::Name ) ) & ", s." & sql.Field ( GetFieldName ( xt_SYSTEMS::PrimaryKey ) ) & ", s." & sql.Field ( GetFieldName ( xt_SYSTEMS::Name ) ) & ", s." & sql.Field ( GetFieldName ( xt_SYSTEMS::BaseURL ) ) & ", s." & sql.Field ( GetFieldName ( xt_SYSTEMS::Token ) ) & " FROM " & sql.Table ( GetFieldName ( sync_SOURCES::PrimaryKey ) ) & " src JOIN " & sql.Table ( GetFieldName ( xt_CONTAINERS::PrimaryKey ) ) & " c ON src." & sql.Field ( GetFieldName ( sync_SOURCES::fk_xtContainer ) ) & " = c." & sql.Field ( GetFieldName ( xt_CONTAINERS::PrimaryKey ) ) & " JOIN " & sql.Table ( GetFieldName ( xt_SYSTEMS::PrimaryKey ) ) & " s ON c." & sql.Field ( GetFieldName ( xt_CONTAINERS::fk_xtSystem ) ) & " = s." & sql.Field ( GetFieldName ( xt_SYSTEMS::PrimaryKey ) ) & " WHERE src." & sql.Field ( GetFieldName ( sync_SOURCES::Name ) ) & " = ?" ; "|" ; "±" ; $sourceName ) ]
If [ IsEmpty ( $ctx ) or Left ( $ctx ; 1 ) = "?" ]
	Show Custom Dialog [ Get ( ScriptName ) ; "Source " & Quote ( $sourceName ) & " was not found, or its container or system is missing." ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ]
End If
Set Variable [ $vals ; Value: Substitute ( $ctx ; "|" ; ¶ ) ]
Set Variable [ $srcPK ; Value: GetValue ( $vals ; 1 ) ]
Set Variable [ $containerPK ; Value: GetValue ( $vals ; 2 ) ]
Set Variable [ $viewPath ; Value: GetValue ( $vals ; 3 ) ]
Set Variable [ $listID ; Value: GetValue ( $vals ; 4 ) ]
Set Variable [ $containerName ; Value: GetValue ( $vals ; 5 ) ]
Set Variable [ $systemPK ; Value: GetValue ( $vals ; 6 ) ]
Set Variable [ $systemName ; Value: GetValue ( $vals ; 7 ) ]
Set Variable [ $baseURL ; Value: GetValue ( $vals ; 8 ) ]
Set Variable [ $token ; Value: GetValue ( $vals ; 9 ) ]
#
# ---------- look up action keys once ----------
Set Variable [ $actionListPK ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( value_LISTS::PrimaryKey ) ) & " FROM " & sql.Table ( GetFieldName ( value_LISTS::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( value_LISTS::Name ) ) & " = 'SYNC_Action'" ; "" ; "" ) ]
Set Variable [ $pullKey ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( VALUES::PrimaryKey ) ) & " FROM " & sql.Table ( GetFieldName ( VALUES::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( VALUES::fk_List ) ) & " = ? AND " & sql.Field ( GetFieldName ( VALUES::Name ) ) & " = 'PULL'" ; "" ; "" ; $actionListPK ) ]
Set Variable [ $adoptKey ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( VALUES::PrimaryKey ) ) & " FROM " & sql.Table ( GetFieldName ( VALUES::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( VALUES::fk_List ) ) & " = ? AND " & sql.Field ( GetFieldName ( VALUES::Name ) ) & " = 'ADOPT'" ; "" ; "" ; $actionListPK ) ]
Set Variable [ $pushKey ; Value: ExecuteSQL ( "SELECT " & sql.Field ( GetFieldName ( VALUES::PrimaryKey ) ) & " FROM " & sql.Table ( GetFieldName ( VALUES::PrimaryKey ) ) & " WHERE " & sql.Field ( GetFieldName ( VALUES::fk_List ) ) & " = ? AND " & sql.Field ( GetFieldName ( VALUES::Name ) ) & " = 'PUSH'" ; "" ; "" ; $actionListPK ) ]
#
# ---------- open session ----------
Go to Layout [ $table_syncSessions ; Animation: None ]
If [ Get ( LastError ) ≠ 0 ]
	Show Custom Dialog [ Get ( ScriptName ) ; "The sync_SESSIONS layout was not found." ]
	Exit Script [ Text Result: JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ]
End If
New Record/Request
Set Field [ sync_SESSIONS::fk_Source ; $srcPK ]
Commit Records/Requests [ With dialog: Off ]
Set Variable [ $sessionPK ; Value: sync_SESSIONS::PrimaryKey ]
#
# ---------- context block ----------
Set Variable [ $context ; Value: JSONSetElement ( "{}" ;
	[ "session" ; $sessionPK ; JSONString ] ;
	[ "source" ; $srcPK ; JSONString ] ;
	[ "container" ; $containerPK ; JSONString ] ;
	[ "viewPath" ; $viewPath ; JSONString ] ;
	[ "listID" ; $listID ; JSONString ] ;
	[ "containerName" ; $containerName ; JSONString ] ;
	[ "system" ; $systemPK ; JSONString ] ;
	[ "systemName" ; $systemName ; JSONString ] ;
	[ "baseURL" ; $baseURL ; JSONString ] ;
	[ "token" ; $token ; JSONString ] ;
	[ "pullKey" ; $pullKey ; JSONString ] ;
	[ "adoptKey" ; $adoptKey ; JSONString ] ;
	[ "pushKey" ; $pushKey ; JSONString ] ) ]
#
# ---------- pull ----------
Perform Script [ Specified: From list ; "adapter PULL | ClickUp" ; Parameter: $context ]
Set Variable [ $pullResult ; Value: Get ( ScriptResult ) ]
If [ JSONGetElement ( $pullResult ; "ok" ) ≠ 1 ]
	Show Custom Dialog [ Get ( ScriptName ) ; "Pull failed.¶¶" & JSONGetElement ( $pullResult ; "error" ) ]
	Go to Layout [ $table_syncSessions ; Animation: None ]
	Enter Find Mode [ Pause: Off ]
	Set Field [ sync_SESSIONS::PrimaryKey ; "==" & $sessionPK ]
	Perform Find [ ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "session" ; $sessionPK ; JSONString ) ]
End If
#
# ---------- dispatch ----------
Perform Script [ Specified: From list ; "sync DISPATCH" ; Parameter: $context ]
Set Variable [ $dispatchResult ; Value: Get ( ScriptResult ) ]
If [ JSONGetElement ( $dispatchResult ; "ok" ) ≠ 1 ]
	Show Custom Dialog [ Get ( ScriptName ) ; "Dispatch failed.¶¶" & JSONGetElement ( $dispatchResult ; "error" ) ]
	Go to Layout [ $table_syncSessions ; Animation: None ]
	Enter Find Mode [ Pause: Off ]
	Set Field [ sync_SESSIONS::PrimaryKey ; "==" & $sessionPK ]
	Perform Find [ ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "session" ; $sessionPK ; JSONString ) ]
End If
#
# ---------- push ----------
If [ $systemName = "ClickUp" ]
	Perform Script [ Specified: From list ; "adapter PUSH | ClickUp" ; Parameter: $context ]
	Set Variable [ $pushResult ; Value: Get ( ScriptResult ) ]
End If
#
# ---------- show session ----------
Go to Layout [ $table_syncSessions ; Animation: None ]
Enter Find Mode [ Pause: Off ]
Set Field [ sync_SESSIONS::PrimaryKey ; "==" & $sessionPK ]
Perform Find [ ]
#
Exit Script [ Text Result: JSONSetElement ( "{}" ;
	[ "ok" ; 1 ; JSONNumber ] ;
	[ "session" ; $sessionPK ; JSONString ] ;
	[ "pulled" ; JSONGetElement ( $pullResult ; "count" ) ; JSONNumber ] ;
	[ "dispatched" ; JSONGetElement ( $dispatchResult ; "count" ) ; JSONNumber ] ;
	[ "pushed" ; If ( IsEmpty ( $pushResult ) ; 0 ; JSONGetElement ( $pushResult ; "count" ) ) ; JSONNumber ] ) ]
