# PEOPLE_Apply
# Button in Reconcile People: Apply.
# Writes every row marked Apply into URITP_PEOPLE through fImportReconcile_URITP_PEOPLE. Asks once first.
Set Error Capture [ On ]
Allow User Abort [ Off ]
Commit Records/Requests [ With dialog: Off ]
Set Variable [ $session ; Value: import_RECONCILE::fkImportSession ]
If [ IsEmpty ( $session ) ]
	Show Custom Dialog [ "Apply from ClickUp" ; "Run this from the Reconcile People window." ]
	Exit Script [ Text Result: 0 ]
End If
# Field map. Same five, same order, as PEOPLE_Compare: first, last, alternate, pronouns, status.
Set Variable [ $write ; Value: List ( GetFieldName ( fImportReconcile_URITP_PEOPLE::Name_First ) ; GetFieldName ( fImportReconcile_URITP_PEOPLE::Name_Last ) ; GetFieldName ( fImportReconcile_URITP_PEOPLE::Name_Alternate ) ; GetFieldName ( fImportReconcile_URITP_PEOPLE::Pronouns ) ; GetFieldName ( fImportReconcile_URITP_PEOPLE::status_Person ) ) ]
Set Variable [ $staged ; Value: List ( GetFieldName ( fImportReconcile_import_CRM::import_Name_First ) ; GetFieldName ( fImportReconcile_import_CRM::import_Name_Last ) ; GetFieldName ( fImportReconcile_import_CRM::import_Name_Alternate ) ; GetFieldName ( fImportReconcile_import_CRM::import_Pronouns ) ; GetFieldName ( fImportReconcile_import_CRM::Import_cu_Status_Person ) ) ]
#
# 1. Find what is marked Apply and not yet applied
Enter Find Mode [ Pause: Off ]
Set Field [ import_RECONCILE::fkImportSession ; "==" & $session ]
Set Field [ import_RECONCILE::Decision ; "==Apply" ]
Set Field [ import_RECONCILE::AppliedTimestamp ; "=" ]
Perform Find [ ]
Set Variable [ $count ; Value: Get ( FoundCount ) ]
If [ $count = 0 ]
	Perform Script [ Specified: From list ; "RECONCILE_ShowSession" ; Parameter: $session ]
	Show Custom Dialog [ "Apply from ClickUp" ; "Nothing is marked Apply." ]
	Exit Script [ Text Result: 0 ]
End If
#
# 2. Confirm
Show Custom Dialog [ "Apply from ClickUp" ; "Write " & $count & " change(s) from ClickUp into URITP_PEOPLE? This overwrites what FileMaker has." ; Buttons: “Apply”, “Cancel” ]
If [ Get ( LastMessageChoice ) ≠ 1 ]
	Perform Script [ Specified: From list ; "RECONCILE_ShowSession" ; Parameter: $session ]
	Exit Script [ Text Result: 0 ]
End If
#
# 3. Write
Freeze Window
Set Variable [ $done ; Value: 0 ]
Set Variable [ $failed ; Value: "" ]
Go to Record/Request/Page [ First ]
Loop [ Flush: Always ]
	If [ import_RECONCILE::Kind = "New" ]
		# Setting a field across fImportReconcile_URITP_PEOPLE creates the person.
		Set Field [ fImportReconcile_URITP_PEOPLE::fkCU_TaskID ; import_RECONCILE::cu_TaskID ]
		Set Variable [ $j ; Value: 0 ]
		Loop [ Flush: Always ]
			Set Variable [ $j ; Value: $j + 1 ]
			Exit Loop If [ $j > ValueCount ( $write ) ]
			Set Field By Name [ GetValue ( $write ; $j ) ; GetField ( GetValue ( $staged ; $j ) ) ]
		End Loop
	Else If [ import_RECONCILE::Kind = "Changed" ]
		# Find which of the five this row is, by the field name Compare wrote.
		Set Variable [ $j ; Value: 0 ]
		Set Variable [ $target ; Value: "" ]
		Loop [ Flush: Always ]
			Set Variable [ $j ; Value: $j + 1 ]
			Exit Loop If [ $j > ValueCount ( $write ) or not IsEmpty ( $target ) ]
			If [ GetValue ( Substitute ( GetValue ( $write ; $j ) ; "::" ; ¶ ) ; 2 ) = import_RECONCILE::FieldName ]
				Set Variable [ $target ; Value: GetValue ( $write ; $j ) ]
			End If
		End Loop
		If [ not IsEmpty ( $target ) ]
			Set Field By Name [ $target ; import_RECONCILE::CU_Value ]
		End If
	End If
	Set Field [ import_RECONCILE::AppliedTimestamp ; Get ( CurrentTimestamp ) ]
	Commit Records/Requests [ With dialog: Off ]
	If [ Get ( LastError ) ≠ 0 ]
		Revert Record/Request [ With dialog: Off ]
		Set Variable [ $failed ; Value: List ( $failed ; import_RECONCILE::PersonName & " " & import_RECONCILE::FieldName ) ]
	Else
		Set Variable [ $done ; Value: $done + 1 ]
	End If
	Go to Record/Request/Page [ Next ; Exit after last: On ]
End Loop
#
# 4. Back to the whole session, and say what happened
Perform Script [ Specified: From list ; "RECONCILE_ShowSession" ; Parameter: $session ]
Show Custom Dialog [ "Apply from ClickUp" ; $done & " applied." & If ( not IsEmpty ( $failed ) ; ¶ & "Not applied:" & ¶ & $failed ; "" ) ]
Exit Script [ Text Result: $done ]
