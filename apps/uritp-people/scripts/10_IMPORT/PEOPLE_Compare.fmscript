# PEOPLE_Compare
# Called by PEOPLE_Pull. Parameter: the session PrimaryKey.
# Writes one RECONCILE row per difference. Result: how many rows it wrote.
Set Error Capture [ On ]
Set Variable [ $session ; Value: Get ( ScriptParameter ) ]
Set Variable [ $fields ; Value: List ( "LegalFirstName" ; "LastName" ; "AltName" ; "Pronouns" ; "cu_Status" ) ]
Set Variable [ $rows ; Value: "[]" ]
Set Variable [ $r ; Value: 0 ]
Set Variable [ $new ; Value: 0 ]
Set Variable [ $changed ; Value: 0 ]
Set Variable [ $gone ; Value: 0 ]
#
# 1. New and Changed: walk this session's staged rows
Go to Layout [ "import_PEOPLE" ; Animation: None ]
Enter Find Mode [ Pause: Off ]
Set Field [ import_PEOPLE::fkImportSession ; "==" & $session ]
Perform Find [ ]
Go to Record/Request/Page [ First ]
Loop [ Flush: Always ]
	Set Variable [ $id ; Value: import_PEOPLE::cu_TaskID ]
	Set Variable [ $ids ; Value: List ( $ids ; $id ) ]
	If [ IsEmpty ( import_PEOPLE__PEOPLE::cu_TaskID ) ]
		Set Variable [ $rows ; Value: JSONSetElement ( $rows ; "[" & $r & "]" ; JSONSetElement ( "{}" ; [ "kind" ; "New" ; JSONString ] ; [ "id" ; $id ; JSONString ] ; [ "imp" ; import_PEOPLE::PrimaryKey ; JSONString ] ; [ "name" ; import_PEOPLE::import_Name ; JSONString ] ; [ "field" ; "" ; JSONString ] ; [ "fmp" ; "" ; JSONString ] ; [ "cu" ; import_PEOPLE::import_Name ; JSONString ] ) ; JSONObject ) ]
		Set Variable [ $r ; Value: $r + 1 ]
		Set Variable [ $new ; Value: $new + 1 ]
	Else
		Set Variable [ $j ; Value: 0 ]
		Loop [ Flush: Always ]
			Set Variable [ $j ; Value: $j + 1 ]
			Exit Loop If [ $j > ValueCount ( $fields ) ]
			Set Variable [ $f ; Value: GetValue ( $fields ; $j ) ]
			Set Variable [ $fmp ; Value: GetField ( "import_PEOPLE__PEOPLE::" & $f ) ]
			Set Variable [ $cu ; Value: GetField ( "import_PEOPLE::import_" & $f ) ]
			# Exact, not =. FileMaker's = ignores case.
			If [ not Exact ( $fmp ; $cu ) ]
				Set Variable [ $rows ; Value: JSONSetElement ( $rows ; "[" & $r & "]" ; JSONSetElement ( "{}" ; [ "kind" ; "Changed" ; JSONString ] ; [ "id" ; $id ; JSONString ] ; [ "imp" ; import_PEOPLE::PrimaryKey ; JSONString ] ; [ "name" ; import_PEOPLE::import_Name ; JSONString ] ; [ "field" ; $f ; JSONString ] ; [ "fmp" ; $fmp ; JSONString ] ; [ "cu" ; $cu ; JSONString ] ) ; JSONObject ) ]
				Set Variable [ $r ; Value: $r + 1 ]
				Set Variable [ $changed ; Value: $changed + 1 ]
			End If
		End Loop
	End If
	Go to Record/Request/Page [ Next ; Exit after last: On ]
End Loop
#
# 2. Gone: people FileMaker has that this pull did not return
Go to Layout [ "util_PEOPLE" ; Animation: None ]
Show All Records
If [ Get ( FoundCount ) > 0 ]
	Go to Record/Request/Page [ First ]
	Loop [ Flush: Always ]
		If [ IsEmpty ( FilterValues ( $ids ; PEOPLE::cu_TaskID ) ) ]
			Set Variable [ $rows ; Value: JSONSetElement ( $rows ; "[" & $r & "]" ; JSONSetElement ( "{}" ; [ "kind" ; "Gone" ; JSONString ] ; [ "id" ; PEOPLE::cu_TaskID ; JSONString ] ; [ "imp" ; "" ; JSONString ] ; [ "name" ; Trim ( PEOPLE::LegalFirstName & " " & PEOPLE::LastName ) ; JSONString ] ; [ "field" ; "" ; JSONString ] ; [ "fmp" ; PEOPLE::cu_Status ; JSONString ] ; [ "cu" ; "" ; JSONString ] ) ; JSONObject ) ]
			Set Variable [ $r ; Value: $r + 1 ]
			Set Variable [ $gone ; Value: $gone + 1 ]
		End If
		Go to Record/Request/Page [ Next ; Exit after last: On ]
	End Loop
End If
#
# 3. Write the review rows
Go to Layout [ "RECONCILE" ; Animation: None ]
Set Variable [ $k ; Value: 0 ]
Loop [ Flush: Always ]
	Exit Loop If [ $k ≥ $r ]
	Set Variable [ $row ; Value: JSONGetElement ( $rows ; "[" & $k & "]" ) ]
	New Record/Request
	Set Field [ RECONCILE::fkImportSession ; $session ]
	Set Field [ RECONCILE::Kind ; JSONGetElement ( $row ; "kind" ) ]
	Set Field [ RECONCILE::cu_TaskID ; JSONGetElement ( $row ; "id" ) ]
	Set Field [ RECONCILE::fkImportPeople ; JSONGetElement ( $row ; "imp" ) ]
	Set Field [ RECONCILE::PersonName ; JSONGetElement ( $row ; "name" ) ]
	Set Field [ RECONCILE::FieldName ; JSONGetElement ( $row ; "field" ) ]
	Set Field [ RECONCILE::FMP_Value ; JSONGetElement ( $row ; "fmp" ) ]
	Set Field [ RECONCILE::CU_Value ; JSONGetElement ( $row ; "cu" ) ]
	Set Field [ RECONCILE::Decision ; If ( JSONGetElement ( $row ; "kind" ) = "Gone" ; "Flag" ; "Apply" ) ]
	Commit Records/Requests [ With dialog: Off ]
	Set Variable [ $k ; Value: $k + 1 ]
End Loop
#
# 4. Counts onto the session
Go to Layout [ "import_SESSIONS" ; Animation: None ]
Enter Find Mode [ Pause: Off ]
Set Field [ import_SESSIONS::PrimaryKey ; "==" & $session ]
Perform Find [ ]
Set Field [ import_SESSIONS::CountNew ; $new ]
Set Field [ import_SESSIONS::CountChanged ; $changed ]
Set Field [ import_SESSIONS::CountGone ; $gone ]
Commit Records/Requests [ With dialog: Off ]
Exit Script [ Text Result: $r ]
